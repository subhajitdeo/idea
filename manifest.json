{
  "manifest_version": 3,
  "name": "Nuvama → Pyodide Bridge",
  "version": "1.0.0",
  "permissions": ["tabs", "storage"],
  "host_permissions": [
    "https://www.nuvamawealth.com/*",
    "http://localhost:*/*",
    "https://*.github.io/*",
    "https://*.vercel.app/*",
    "https://*.netlify.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.nuvamawealth.com/markets/options*"],
      "js": ["scraper.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://localhost:*/*",
        "https://*.github.io/*",
        "https://*.vercel.app/*",
        "https://*.netlify.app/*"
      ],
      "js": ["relay.js"],
      "run_at": "document_idle"
    }
  ]
}
